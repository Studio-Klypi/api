{{#> layouts/main title="Votre galerie est disponible" preheader=(concat "Bonjour " clientName " ! Votre galerie « " galleryTitle " » est maintenant disponible.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Galerie disponible</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{clientName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Votre galerie photo est maintenant disponible. Vous pouvez dès à présent la consulter et sélectionner vos photos préférées dans la limite de votre quota.
    </p>

    <!-- Gallery card -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
      <tr>
        <td style="padding: 16px 20px; border-bottom: 1px solid #e4e4e7; background-color: #fdf2fc;">
          <span style="font-size: 11px; font-weight: 600; color: #E160D6; text-transform: uppercase; letter-spacing: 0.8px;">Votre galerie</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 20px 20px;">
          <span style="font-size: 12px; font-weight: 500; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px;">Titre</span>
          <p style="margin: 4px 0 0 0; font-size: 14px; color: #27272a; line-height: 1.5; font-weight: 500;">{{galleryTitle}}</p>
        </td>
      </tr>
    </table>

    <!-- CTA Button -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 28px;">
      <tr>
        <td align="center">
          <a href="{{galleryUrl}}" target="_blank" style="display: inline-block; background-color: #E160D6; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 32px; border-radius: 8px; letter-spacing: -0.1px;">
            Consulter ma galerie
          </a>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
