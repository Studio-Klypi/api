{{#> layouts/main title="Votre galerie est fermée" preheader=(concat "Bonjour " clientName " ! L'accès à votre galerie « " galleryTitle " » n'est plus disponible.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #f4f4f5; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #71717a;">Galerie fermée</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{clientName}},
    </h2>
    <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      L'accès à votre galerie <strong style="color: #0a0a0a;">{{galleryTitle}}</strong> n'est désormais plus disponible.
    </p>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Si vous souhaitez à nouveau accéder à vos photos, n'hésitez pas à nous contacter. Toute réouverture de galerie pourra faire l'objet d'une nouvelle facturation.
    </p>

    <!-- Billing notice -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fff1f2; border: 1px solid #fecdd3; border-radius: 8px;">
      <tr>
        <td style="padding: 14px 20px;">
          <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #9f1239;">
            <strong>Important :</strong> Toute demande de réouverture ou de récupération de photos après la fermeture de la galerie pourra entraîner une facturation supplémentaire.
          </p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
