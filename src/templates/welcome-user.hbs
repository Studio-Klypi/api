{{#> layouts/main title="Bienvenue sur Nexus" preheader=(concat "Bienvenue " firstName " ! Votre compte Nexus a été créé. Découvrez comment vous connecter.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Compte créé</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bienvenue {{firstName}} !
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Un compte {{backofficeName}} vient d'être créé pour vous. Vous trouverez ci-dessous vos identifiants de connexion ainsi que les étapes pour commencer à utiliser l'application.
    </p>

    <!-- Credentials card -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
      <tr>
        <td style="padding: 16px 20px; border-bottom: 1px solid #e4e4e7; background-color: #fdf2fc;">
          <span style="font-size: 11px; font-weight: 600; color: #E160D6; text-transform: uppercase; letter-spacing: 0.8px;">Vos identifiants</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 8px 20px;">
          <span style="font-size: 12px; font-weight: 500; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px;">Email</span>
          <p style="margin: 4px 0 0 0; font-size: 14px; color: #27272a; line-height: 1.5; font-weight: 500;">{{email}}</p>
        </td>
      </tr>
      <tr>
        <td style="padding: 12px 20px 20px 20px;">
          <span style="font-size: 12px; font-weight: 500; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px;">Mot de passe</span>
          <p style="margin: 4px 0 0 0; font-size: 14px; color: #27272a; line-height: 1.5; font-weight: 500; font-family: monospace, monospace;">{{password}}</p>
        </td>
      </tr>
    </table>

    <!-- Steps -->
    <p style="margin: 28px 0 16px 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      Pour commencer :
    </p>

    <!-- Step 1 -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 12px;">
      <tr>
        <td width="28" valign="top" style="padding-top: 2px;">
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="background-color: #E160D6; border-radius: 50%; width: 24px; height: 24px; text-align: center; line-height: 24px;">
                <span style="font-size: 12px; font-weight: 600; color: #ffffff;">1</span>
              </td>
            </tr>
          </table>
        </td>
        <td style="padding-left: 12px;">
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
            Ouvrez l'application <strong style="color: #0a0a0a;">{{backofficeName}}</strong> via ce lien {{backofficeUrl}}.
          </p>
        </td>
      </tr>
    </table>

    <!-- Step 2 -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 12px;">
      <tr>
        <td width="28" valign="top" style="padding-top: 2px;">
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="background-color: #E160D6; border-radius: 50%; width: 24px; height: 24px; text-align: center; line-height: 24px;">
                <span style="font-size: 12px; font-weight: 600; color: #ffffff;">2</span>
              </td>
            </tr>
          </table>
        </td>
        <td style="padding-left: 12px;">
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
            <a href="{{backofficeAuthUrl}}" target="_blank">Connectez-vous</a> avec votre email et le mot de passe ci-dessus.
          </p>
        </td>
      </tr>
    </table>

    <!-- Step 3 -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 12px;">
      <tr>
        <td width="28" valign="top" style="padding-top: 2px;">
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="background-color: #E160D6; border-radius: 50%; width: 24px; height: 24px; text-align: center; line-height: 24px;">
                <span style="font-size: 12px; font-weight: 600; color: #ffffff;">3</span>
              </td>
            </tr>
          </table>
        </td>
        <td style="padding-left: 12px;">
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
            Rendez-vous sur votre <strong style="color: #0a0a0a;">profil</strong> pour modifier votre mot de passe.
          </p>
        </td>
      </tr>
    </table>

    <!-- Step 4 -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 4px;">
      <tr>
        <td width="28" valign="top" style="padding-top: 2px;">
          <table role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td style="background-color: #E160D6; border-radius: 50%; width: 24px; height: 24px; text-align: center; line-height: 24px;">
                <span style="font-size: 12px; font-weight: 600; color: #ffffff;">4</span>
              </td>
            </tr>
          </table>
        </td>
        <td style="padding-left: 12px;">
          <p style="margin: 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
            Choisissez un <strong style="color: #0a0a0a;">nouveau mot de passe</strong> personnel et sécurisé.
          </p>
        </td>
      </tr>
    </table>

    <!-- Security notice -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 24px; background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;">
      <tr>
        <td style="padding: 14px 20px;">
          <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #92400e;">
            <strong>Sécurité :</strong> Nous vous recommandons fortement de changer votre mot de passe dès votre première connexion.
          </p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      L'application est maintenant prête à être utilisée. Bonne découverte !
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
