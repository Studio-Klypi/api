{{#> layouts/main title="Merci pour votre témoignage" preheader=(concat "Merci " firstName " ! Votre témoignage a bien été reçu et sera examiné par notre équipe.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Témoignage bien reçu</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Merci {{firstName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Nous vous remercions d'avoir pris le temps de partager votre expérience. Votre témoignage sera examiné par notre équipe avant d'être publié.
    </p>

    <!-- Testimonial card -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
      <tr>
        <td style="padding: 16px 20px; border-bottom: 1px solid #e4e4e7; background-color: #fdf2fc;">
          <span style="font-size: 11px; font-weight: 600; color: #E160D6; text-transform: uppercase; letter-spacing: 0.8px;">Votre témoignage</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 20px;">
          <p style="margin: 0; font-size: 14px; color: #27272a; line-height: 1.6; font-style: italic; white-space: pre-wrap;">« {{text}} »</p>
          <p style="margin: 12px 0 0 0; font-size: 13px; color: #71717a;">
            — {{firstName}} {{lastName}}{{#if role}}, {{role}}{{/if}}
          </p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
