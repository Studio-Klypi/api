{{#> layouts/main title="Confirmation de contact" preheader=(concat "Nous avons bien reçu votre message, " firstName ". Notre équipe reviendra vers vous rapidement.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Message bien reçu</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{firstName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Merci de nous avoir contacté. Nous avons bien reçu votre message et notre équipe le traitera dans les plus brefs délais.
    </p>

    <!-- Message summary card -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
      <tr>
        <td style="padding: 16px 20px; border-bottom: 1px solid #e4e4e7; background-color: #fdf2fc;">
          <span style="font-size: 11px; font-weight: 600; color: #E160D6; text-transform: uppercase; letter-spacing: 0.8px;">Récapitulatif</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 8px 20px;">
          <span style="font-size: 12px; font-weight: 500; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px;">Objet</span>
          <p style="margin: 4px 0 0 0; font-size: 14px; color: #27272a; line-height: 1.5; font-weight: 500;">{{subject}}</p>
        </td>
      </tr>
      <tr>
        <td style="padding: 12px 20px 20px 20px;">
          <span style="font-size: 12px; font-weight: 500; color: #a1a1aa; text-transform: uppercase; letter-spacing: 0.5px;">Message</span>
          <p style="margin: 4px 0 0 0; font-size: 14px; color: #27272a; line-height: 1.6; white-space: pre-wrap;">{{message}}</p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
