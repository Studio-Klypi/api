{{#> layouts/main title="Confirmation de contact"}}

<div style="padding: 24px 40px 32px;">
  <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 600; color: #0a0a0a;">
    Bonjour {{firstName}},
  </h2>
  <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    Merci de nous avoir contacté. Nous avons bien reçu votre message et notre équipe le traitera dans les plus brefs délais.
  </p>

  <div style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
    <p style="margin: 0 0 4px; font-size: 12px; color: #a1a1aa; text-transform: uppercase;">Objet</p>
    <p style="margin: 0 0 12px; font-size: 14px; color: #27272a; font-weight: 500;">{{subject}}</p>
    <p style="margin: 0 0 4px; font-size: 12px; color: #a1a1aa; text-transform: uppercase;">Message</p>
    <p style="margin: 0; font-size: 14px; color: #27272a; line-height: 1.6;">{{message}}</p>
  </div>

  <p style="margin: 0 0 4px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    À très bientôt,
  </p>
  <p style="margin: 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
    L'équipe Studio Klypi
  </p>
</div>

{{/layouts/main}}
