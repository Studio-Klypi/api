{{#> layouts/main title="Sélection validée" preheader=(concat "Bonjour " clientName " ! Votre sélection pour la galerie « " galleryTitle " » a bien été prise en compte.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Sélection validée</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{clientName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Votre sélection pour la galerie <strong style="color: #0a0a0a;">{{galleryTitle}}</strong> a bien été prise en compte. Les retouches vont maintenant pouvoir commencer.
    </p>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Vous recevrez un email dès que vos photos retouchées seront disponibles.
    </p>

    <!-- CTA Button -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <a href="{{galleryUrl}}" target="_blank" style="display: inline-block; background-color: #E160D6; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 32px; border-radius: 8px; letter-spacing: -0.1px;">
            Voir ma galerie
          </a>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
