{{#> layouts/main title="Compte désactivé" preheader=(concat firstName ", votre compte " backofficeName " a été désactivé.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fef2f2; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #dc2626;">Compte désactivé</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{firstName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Nous vous informons que votre compte <strong style="color: #0a0a0a;">{{backofficeName}}</strong> a été désactivé par un administrateur. Vous ne pouvez plus accéder à l'application avec vos identifiants actuels.
    </p>

    <!-- Info notice -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; overflow: hidden;">
      <tr>
        <td style="padding: 16px 20px; border-bottom: 1px solid #e4e4e7; background-color: #fef2f2;">
          <span style="font-size: 11px; font-weight: 600; color: #dc2626; text-transform: uppercase; letter-spacing: 0.8px;">Ce que cela signifie</span>
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px;">
          <p style="margin: 0 0 8px 0; font-size: 14px; color: #27272a; line-height: 1.6;">
            Votre accès à {{backofficeName}} est suspendu. Vos données sont conservées mais vous ne pouvez plus vous connecter.
          </p>
          <p style="margin: 0; font-size: 14px; color: #27272a; line-height: 1.6;">
            Si vous souhaitez réactiver votre compte, veuillez contacter votre administrateur.
          </p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
