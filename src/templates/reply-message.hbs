    Bonjour {{firstName}},
  </h2>
  <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    {{message}}
  </p>

  <p style="margin: 0 0 4px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    À très bientôt,
  </p>
  <p style="margin: 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
    L'équipe Studio Klypi
  </p>
</div>

{{/layouts/main}}
