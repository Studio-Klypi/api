{{#> layouts/main title="Votre galerie a été mise à jour" preheader=(concat "Bonjour " clientName " ! Le lien d'accès à votre galerie « " galleryTitle " » a changé.")}}

<!-- Badge -->
<tr>
  <td align="center" style="padding: 32px 40px 0 40px;">
    <table role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td style="background-color: #fdf2fc; border-radius: 20px; padding: 6px 16px;">
          <span style="font-size: 13px; font-weight: 500; color: #E160D6;">Votre galerie</span>
        </td>
      </tr>
    </table>
  </td>
</tr>

<!-- Body -->
<tr>
  <td class="content-padding" style="padding: 24px 40px 32px 40px;">
    <h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 600; color: #0a0a0a; line-height: 1.3;">
      Bonjour {{clientName}},
    </h2>
    <p style="margin: 0 0 28px 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      Le nom de votre galerie photo <strong style="color: #0a0a0a;">{{galleryTitle}}</strong> a été modifié. Votre lien d'accès a donc changé. Vous pouvez retrouver votre galerie depuis le bouton ci-dessous.
    </p>

    <!-- CTA Button -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 28px;">
      <tr>
        <td align="center">
          <a href="{{galleryUrl}}" target="_blank" style="display: inline-block; background-color: #E160D6; color: #ffffff; font-size: 15px; font-weight: 600; text-decoration: none; padding: 14px 32px; border-radius: 8px; letter-spacing: -0.1px;">
            Accéder à ma galerie
          </a>
        </td>
      </tr>
    </table>

    {{#if expiresAt}}
    <!-- Expiration notice -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; margin-bottom: 12px;">
      <tr>
        <td style="padding: 14px 20px;">
          <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #92400e;">
            <strong>Attention :</strong> L'accès à votre galerie expirera le {{expiresAt}}. Pensez à enregistrer vos photos avant cette date.
          </p>
        </td>
      </tr>
    </table>
    {{/if}}

    <!-- Info notice -->
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f4f5; border-radius: 8px;">
      <tr>
        <td style="padding: 14px 20px;">
          <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #52525b;">
            Si vous avez enregistré l'ancien lien dans vos favoris, pensez à le mettre à jour avec le nouveau.
          </p>
        </td>
      </tr>
    </table>

    <p style="margin: 28px 0 0 0; font-size: 15px; line-height: 1.7; color: #3f3f46;">
      À très bientôt,
    </p>
    <p style="margin: 4px 0 0 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
      L'équipe Studio Klypi
    </p>
  </td>
</tr>

{{/layouts/main}}
