{{#> layouts/main title="Nouveau mot de passe"}}

<div style="padding: 24px 40px 32px;">
  <h2 style="margin: 0 0 16px; font-size: 20px; font-weight: 600; color: #0a0a0a;">
    Bonjour {{firstName}},
  </h2>
  <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    Un administrateur a généré un nouveau mot de passe pour votre compte {{backofficeName}}.
  </p>

  <div style="background-color: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px;">
    <p style="margin: 0 0 4px; font-size: 12px; color: #a1a1aa; text-transform: uppercase;">Email</p>
    <p style="margin: 0 0 12px; font-size: 14px; color: #27272a; font-weight: 500;">{{email}}</p>
    <p style="margin: 0 0 4px; font-size: 12px; color: #a1a1aa; text-transform: uppercase;">Nouveau mot de passe</p>
    <p style="margin: 0; font-size: 14px; color: #27272a; font-weight: 500; font-family: monospace;">{{password}}</p>
  </div>

  <p style="margin: 0 0 8px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    1. Connectez-vous sur <a href="{{backofficeAuthUrl}}" style="color: #E160D6;">{{backofficeName}}</a>
  </p>
  <p style="margin: 0 0 8px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    2. Rendez-vous sur votre profil pour modifier votre mot de passe.
  </p>
  <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    3. Choisissez un nouveau mot de passe personnel et sécurisé.
  </p>

  <p style="margin: 0 0 4px; font-size: 15px; line-height: 1.7; color: #3f3f46;">
    À très bientôt,
  </p>
  <p style="margin: 0; font-size: 15px; font-weight: 600; color: #0a0a0a;">
    L'équipe Studio Klypi
  </p>
</div>

{{/layouts/main}}
