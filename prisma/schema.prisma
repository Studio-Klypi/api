generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// PROJECTS \\
enum ProjectStatus {
  draft
  published
  archived
}

enum ProjectVisibility {
  public
  private
}

model Project {
  id          Int               @id @default(autoincrement())
  slug        String
  title       String
  description String
  banner      String?
  status      ProjectStatus     @default(draft)
  visibility  ProjectVisibility @default(private)
  sections    Json              @default("[]") @db.JsonB
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?

  @@unique([id, slug])
  @@map("projects")
}

// CONTACT \\
model Testimonial {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  avatar      String?
  email       String
  role        String?
  text        String
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?
  processedAt DateTime?

  @@map("testimonials")
}

enum ContactType {
  contact
  quote
  partnership
  sponsoring
}

model Contact {
  id          Int         @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  type        ContactType @default(contact)
  subject     String
  message     String
  createdAt   DateTime    @default(now())
  processedAt DateTime?

  @@map("contacts")
}
