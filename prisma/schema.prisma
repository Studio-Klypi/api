generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USER \\
enum UserRole {
  superadmin
  admin
  frontline
}

model User {
  id           Int       @id @default(autoincrement())
  key          String    @unique @default(cuid())
  avatar       String?
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(frontline)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions Session[]

  @@map("users")
}

model Session {
  sid       String    @id @default(cuid())
  userId    Int
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// PROJECTS \\
enum ProjectStatus {
  draft
  published
  archived
}

enum ProjectVisibility {
  public
  private
}

model Project {
  id          Int               @id @default(autoincrement())
  slug        String
  title       String
  description String
  banner      String?
  status      ProjectStatus     @default(draft)
  visibility  ProjectVisibility @default(private)
  sections    Json              @default("[]") @db.JsonB
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?

  @@unique([id, slug])
  @@map("projects")
}

// CONTACT \\
model Testimonial {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  avatar      String?
  email       String
  role        String?
  text        String
  createdAt   DateTime  @default(now())
  verifiedAt  DateTime?
  processedAt DateTime?

  @@map("testimonials")
}

enum ContactType {
  contact
  quote
  partnership
  sponsoring
}

model Contact {
  id          Int         @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  type        ContactType @default(contact)
  subject     String
  message     String
  createdAt   DateTime    @default(now())
  processedAt DateTime?

  @@map("contacts")
}

// PRIVATE GALLERY \\
enum GalleryStatus {
  draft
  selection
  retouching
  delivered
  closed
}

enum ShootingType {
  studio
  outside
  event
}

model Gallery {
  id           Int           @id @default(autoincrement())
  key          String        @unique @default(cuid())
  slug         String
  title        String
  status       GalleryStatus @default(draft)
  clientName   String
  clientEmails String[]
  photoQuota   Int           @default(0)
  shootingDate DateTime
  shootingCity String?
  shootingType ShootingType
  deliveredAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pictures  Picture[]
  retouches Retouch[]

  @@unique([id, slug])
  @@map("galleries")
}

model Picture {
  id           Int       @id @default(autoincrement())
  galleryId    Int
  storageKey   String
  thumbnailKey String
  filename     String
  size         Int
  order        Int
  selected     Boolean
  selectedAt   DateTime?
  downloadedAt DateTime?
  retouchCount Int       @default(0)
  createdAt    DateTime  @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  retouches Retouch[]

  @@map("pictures")
}

model Retouch {
  id           Int      @id @default(autoincrement())
  pictureId    Int
  galleryId    Int
  storageKey   String
  thumbnailKey String
  version      Int      @default(1)
  createdAt    DateTime @default(now())

  picture Picture @relation(fields: [pictureId], references: [id], onDelete: Cascade)
  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("retouches")
}
